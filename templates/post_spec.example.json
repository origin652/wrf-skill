{
  "schema_version": 4,
  "project_name": "demo",
  "defaults": {
    "inputs": {
      "mode": "project_artifacts",
      "artifact": "wrfout_files"
    },
    "selectors": {
      "domain": "d01",
      "time_indices": null,
      "time_range": {
        "start": null,
        "end": null
      },
      "max_files": null
    },
    "render": {
      "format": "png",
      "title": null,
      "dpi": 150
    },
    "output": {
      "subdir": "plots",
      "file_stem": null,
      "sidecar_json": true,
      "overwrite": false
    }
  },
  "style_defs": {
    "temperature_raster": {
      "kind": "raster",
      "alpha": 1.0,
      "zorder": 10,
      "style": {
        "colormap": "coolwarm",
        "show_colorbar": true
      }
    },
    "terrain_contours": {
      "kind": "contour",
      "alpha": 0.8,
      "zorder": 20,
      "style": {
        "levels": [
          0,
          500,
          1000,
          1500,
          2000
        ],
        "colors": "black",
        "linewidths": 0.5
      }
    },
    "precip_raster": {
      "kind": "raster",
      "alpha": 0.95,
      "zorder": 10,
      "style": {
        "colormap": "Blues",
        "show_colorbar": true
      }
    },
    "wind_raster": {
      "kind": "raster",
      "alpha": 1.0,
      "zorder": 10,
      "style": {
        "colormap": "viridis",
        "show_colorbar": true
      }
    },
    "wind_quiver": {
      "kind": "vector",
      "alpha": 0.9,
      "zorder": 30,
      "style": {
        "mode": "quiver",
        "stride": 4,
        "scale": 80,
        "color": "black",
        "pivot": "mid"
      }
    },
    "section_wind_quiver": {
      "kind": "vector",
      "alpha": 0.85,
      "zorder": 30,
      "style": {
        "mode": "quiver",
        "stride": 3,
        "scale": 400,
        "color": "black",
        "pivot": "mid",
        "axis_projection": {
          "kind": "path_section",
          "x_component": "path_tangent",
          "y_component": "vertical"
        }
      }
    },
    "moisture_raster": {
      "kind": "raster",
      "alpha": 1.0,
      "zorder": 10,
      "style": {
        "colormap": "YlGnBu",
        "show_colorbar": true
      }
    },
    "landmask_fill": {
      "kind": "categorical_fill",
      "alpha": 0.35,
      "zorder": 1,
      "style": {
        "categories": [
          {
            "value": 0,
            "color": "#4c78a8",
            "label": "water"
          },
          {
            "value": 1,
            "color": "#e0c36e",
            "label": "land"
          }
        ]
      }
    }
  },
  "view_defs": {
    "time_x_line_y50": {
      "x_axis": {
        "name": "time",
        "label": "time_index"
      },
      "y_axis": {
        "name": "west_east",
        "label": "west_east"
      },
      "selectors": {
        "south_north": {
          "mode": "index",
          "index": 50
        }
      }
    },
    "time_x_mean_sn": {
      "x_axis": {
        "name": "time",
        "label": "time_index"
      },
      "y_axis": {
        "name": "west_east",
        "label": "west_east"
      },
      "selectors": {
        "south_north": {
          "mode": "mean"
        }
      }
    },
    "height_time_column": {
      "x_axis": {
        "kind": "derived_coord",
        "name": "height_m"
      },
      "y_axis": {
        "name": "time"
      },
      "selectors": {
        "south_north": {
          "mode": "index",
          "index": 50
        },
        "west_east": {
          "mode": "index",
          "index": 50
        }
      }
    },
    "time_pressure_column": {
      "x_axis": {
        "name": "time"
      },
      "y_axis": {
        "kind": "derived_coord",
        "name": "pressure_hpa"
      },
      "selectors": {
        "south_north": {
          "mode": "index",
          "index": 50
        },
        "west_east": {
          "mode": "index",
          "index": 50
        }
      }
    },
    "distance_height_path": {
      "x_axis": {
        "kind": "path_coord",
        "name": "distance_km"
      },
      "y_axis": {
        "kind": "derived_coord",
        "name": "height_m"
      },
      "selectors": {
        "time": {
          "mode": "current"
        }
      },
      "sampling": {
        "path": {
          "kind": "polyline",
          "points": [
            {
              "lat": 31.2,
              "lon": 121.4
            },
            {
              "lat": 31.8,
              "lon": 122.1
            }
          ],
          "samples": 200
        }
      }
    }
  },
  "layer_defs": {
    "terrain": {
      "source": {
        "kind": "wrf_native_2d"
      },
      "expr": "first(HGT)",
      "units": "m",
      "metadata": {
        "description": "Terrain height from the first selected frame"
      }
    },
    "landmask": {
      "source": {
        "kind": "wrf_native_2d"
      },
      "expr": "first(LANDMASK)",
      "units": null,
      "metadata": {
        "description": "Static land-sea mask"
      }
    },
    "t2_c": {
      "source": {
        "kind": "wrf_native_2d"
      },
      "expr": "T2 - 273.15",
      "units": "C",
      "metadata": {
        "description": "2m temperature in Celsius"
      }
    },
    "wind10m": {
      "source": {
        "kind": "wrf_diag"
      },
      "expr": "wind_speed_10m",
      "units": "m s-1",
      "metadata": {
        "description": "10m wind speed magnitude from built-in diagnostics"
      }
    },
    "u10": {
      "source": {
        "kind": "wrf_native_2d"
      },
      "expr": "U10",
      "units": "m s-1",
      "metadata": {
        "description": "10m zonal wind component"
      }
    },
    "v10": {
      "source": {
        "kind": "wrf_native_2d"
      },
      "expr": "V10",
      "units": "m s-1",
      "metadata": {
        "description": "10m meridional wind component"
      }
    },
    "u_mass": {
      "source": {
        "kind": "wrf_native_3d_full"
      },
      "expr": "U",
      "units": "m s-1",
      "metadata": {
        "description": "WRF native zonal wind; section views destagger west_east_stag onto the mass grid"
      }
    },
    "v_mass": {
      "source": {
        "kind": "wrf_native_3d_full"
      },
      "expr": "V",
      "units": "m s-1",
      "metadata": {
        "description": "WRF native meridional wind; section views destagger south_north_stag onto the mass grid"
      }
    },
    "w_mass": {
      "source": {
        "kind": "wrf_native_3d_full"
      },
      "expr": "W",
      "units": "m s-1",
      "metadata": {
        "description": "WRF native vertical wind; section views destagger bottom_top_stag onto the mass grid"
      }
    },
    "qvapor_lvl0_gkg": {
      "source": {
        "kind": "wrf_native_3d",
        "level_selector": {
          "mode": "first"
        }
      },
      "expr": "QVAPOR * 1000",
      "units": "g kg-1",
      "metadata": {
        "description": "Lowest model-level water vapor mixing ratio"
      }
    },
    "qvapor_cube_gkg": {
      "source": {
        "kind": "wrf_native_3d_full"
      },
      "expr": "QVAPOR * 1000",
      "units": "g kg-1",
      "metadata": {
        "description": "3D water vapor mixing ratio for time-height and path sections"
      }
    },
    "accum_precip": {
      "source": {
        "kind": "wrf_diag"
      },
      "expr": "last(total_precip) - first(total_precip)",
      "units": "mm",
      "metadata": {
        "description": "Accumulated precipitation across the selected frame range"
      }
    }
  },
  "region_defs": {
    "west_box": {
      "label": "West Box",
      "south_north": {
        "mode": "index_range",
        "start": 0,
        "stop": 80
      },
      "west_east": {
        "mode": "index_range",
        "start": 0,
        "stop": 80
      }
    },
    "east_box": {
      "label": "East Box",
      "south_north": {
        "mode": "index_range",
        "start": 0,
        "stop": 80
      },
      "west_east": {
        "mode": "index_range",
        "start": 80,
        "stop": 160
      }
    }
  },
  "figures": [
    {
      "figure_id": "surface_temperature",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "2m Temperature with Terrain"
      },
      "output": {
        "file_stem": "surface-temperature"
      },
      "layers": [
        {
          "layer_id": "t2_c",
          "style_id": "temperature_raster"
        },
        {
          "layer_id": "terrain",
          "style_id": "terrain_contours"
        }
      ]
    },
    {
      "figure_id": "wind10m_diagnostic",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "10m Wind Speed Diagnostic"
      },
      "output": {
        "file_stem": "wind10m-diagnostic"
      },
      "layers": [
        {
          "layer_id": "wind10m",
          "style_id": "wind_raster"
        },
        {
          "layer_id": "terrain",
          "style_id": "terrain_contours"
        }
      ]
    },
    {
      "figure_id": "accum_precip_overview",
      "selectors": {
        "time_indices": [
          0,
          6
        ]
      },
      "render": {
        "title": "Accumulated Precipitation Overview"
      },
      "output": {
        "file_stem": "accum-precip-overview"
      },
      "layers": [
        {
          "layer_id": "landmask",
          "style_id": "landmask_fill"
        },
        {
          "layer_id": "accum_precip",
          "style_id": "precip_raster"
        },
        {
          "layer_id": "terrain",
          "style_id": "terrain_contours",
          "draw": {
            "style": {
              "levels": [
                0,
                500,
                1000,
                1500
              ]
            }
          }
        }
      ]
    },
    {
      "figure_id": "surface_wind_vectors",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "2m Temperature with 10m Wind Vectors"
      },
      "output": {
        "file_stem": "surface-wind-vectors"
      },
      "layers": [
        {
          "layer_id": "t2_c",
          "style_id": "temperature_raster"
        },
        {
          "u_layer_id": "u10",
          "v_layer_id": "v10",
          "style_id": "wind_quiver"
        },
        {
          "layer_id": "terrain",
          "style_id": "terrain_contours"
        }
      ]
    },
    {
      "figure_id": "time_x_temperature_section",
      "view_id": "time_x_line_y50",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "Time-X Temperature Section"
      },
      "output": {
        "file_stem": "time-x-temperature-section"
      },
      "layers": [
        {
          "layer_id": "t2_c",
          "style_id": "temperature_raster"
        }
      ]
    },
    {
      "figure_id": "time_x_temperature_mean_section",
      "view_id": "time_x_mean_sn",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "Time-X Temperature Mean Section"
      },
      "output": {
        "file_stem": "time-x-temperature-mean-section"
      },
      "layers": [
        {
          "layer_id": "t2_c",
          "style_id": "temperature_raster"
        }
      ]
    },
    {
      "figure_id": "lowest_level_qvapor",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "Lowest-Level Water Vapor"
      },
      "output": {
        "file_stem": "lowest-level-qvapor"
      },
      "layers": [
        {
          "layer_id": "qvapor_lvl0_gkg",
          "style_id": "moisture_raster"
        },
        {
          "layer_id": "terrain",
          "style_id": "terrain_contours"
        }
      ]
    },
    {
      "figure_id": "height_time_qvapor_column",
      "view_id": "height_time_column",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "Height-Time Water Vapor Column"
      },
      "output": {
        "file_stem": "height-time-qvapor-column"
      },
      "layers": [
        {
          "layer_id": "qvapor_cube_gkg",
          "style_id": "moisture_raster"
        }
      ]
    },
    {
      "figure_id": "time_pressure_qvapor_column",
      "view_id": "time_pressure_column",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "render": {
        "title": "Time-Pressure Water Vapor Column"
      },
      "output": {
        "file_stem": "time-pressure-qvapor-column"
      },
      "layers": [
        {
          "layer_id": "qvapor_cube_gkg",
          "style_id": "moisture_raster"
        }
      ]
    },
    {
      "figure_id": "distance_height_qvapor_section",
      "view_id": "distance_height_path",
      "selectors": {
        "time_indices": [
          0
        ]
      },
      "render": {
        "title": "Distance-Height Water Vapor Section"
      },
      "output": {
        "file_stem": "distance-height-qvapor-section"
      },
      "layers": [
        {
          "layer_id": "qvapor_cube_gkg",
          "style_id": "moisture_raster"
        }
      ]
    },
    {
      "figure_id": "distance_height_wind_section",
      "view_id": "distance_height_path",
      "selectors": {
        "time_indices": [
          0
        ]
      },
      "render": {
        "title": "Distance-Height Water Vapor with Path Wind Vectors"
      },
      "output": {
        "file_stem": "distance-height-wind-section"
      },
      "layers": [
        {
          "layer_id": "qvapor_cube_gkg",
          "style_id": "moisture_raster"
        },
        {
          "u_layer_id": "u_mass",
          "v_layer_id": "v_mass",
          "vertical_layer_id": "w_mass",
          "style_id": "section_wind_quiver"
        }
      ]
    }
  ],
  "charts": [
    {
      "chart_id": "west_box_t2_time_mean",
      "chart_kind": "line",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "x": {
        "mode": "time",
        "label": "valid_time"
      },
      "render": {
        "title": "West Box Mean 2m Temperature"
      },
      "output": {
        "file_stem": "west-box-t2-time-mean"
      },
      "series": [
        {
          "series_id": "west_mean",
          "label": "West Box Mean T2",
          "layer_id": "t2_c",
          "region_id": "west_box",
          "reduce": {
            "mode": "mean"
          }
        }
      ]
    },
    {
      "chart_id": "grouped_t2_last_frame",
      "chart_kind": "bar",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "x": {
        "mode": "group",
        "group_ids": [
          "west_box",
          "east_box"
        ],
        "label": "region"
      },
      "render": {
        "title": "Grouped 2m Temperature at Final Frame"
      },
      "output": {
        "file_stem": "grouped-t2-last-frame"
      },
      "series": [
        {
          "series_id": "group_mean",
          "label": "Group Mean T2",
          "layer_id": "t2_c",
          "reduce": {
            "mode": "mean"
          }
        }
      ]
    },
    {
      "chart_id": "grouped_t2_time_distribution",
      "chart_kind": "boxplot",
      "selectors": {
        "time_indices": [
          0,
          1,
          2
        ]
      },
      "x": {
        "mode": "group",
        "group_ids": [
          "west_box",
          "east_box"
        ],
        "label": "region"
      },
      "render": {
        "title": "Grouped Time Distribution of Mean 2m Temperature"
      },
      "output": {
        "file_stem": "grouped-t2-time-distribution"
      },
      "series": [
        {
          "series_id": "group_distribution",
          "label": "Time Distribution of Group Mean T2",
          "layer_id": "t2_c",
          "reduce": {
            "mode": "mean"
          }
        }
      ]
    }
  ]
}
