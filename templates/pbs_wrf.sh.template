#!/usr/bin/env bash
#PBS -N {project_name}
#PBS -q {partition}
#PBS -A {account}
#PBS -l select={nodes}:ncpus={tasks_per_node}
#PBS -l walltime={walltime_hours}:00:00
#PBS -o {remote_log_dir}/pbs.out
#PBS -e {remote_log_dir}/pbs.err

set -euo pipefail

mkdir -p "{remote_project_dir}/output" "{remote_log_dir}"
cd "{remote_project_dir}/wrf"

{module_load_block}
{activate_block}

MAIN_LOG="{remote_log_dir}/wrf-run.log"
printf 'wrf-run project=%s\n' "{project_name}" > "$MAIN_LOG"
printf 'work_dir=%s\n' "{remote_project_dir}/wrf" >> "$MAIN_LOG"
printf 'selected_substeps=%s\n' "{selected_substeps}" >> "$MAIN_LOG"

{stage_met_em_block}
{substep_helpers_block}
{substep_prepare_block}
{substep_run_block}

printf 'status=completed\n' >> "$MAIN_LOG"
