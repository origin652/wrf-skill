{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WRF post-processing specification",
  "type": "object",
  "required": [
    "schema_version",
    "layer_defs",
    "figures"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "style_defs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/draw"
      }
    },
    "layer_defs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/layer_def"
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/figure"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "time_token": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "category_value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "partial_inputs": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "project_artifacts",
            "explicit_paths",
            "glob"
          ]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "allOf": [
        {
          "$ref": "#/$defs/partial_inputs"
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "project_artifacts"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "artifact"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "explicit_paths"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "paths"
            ],
            "properties": {
              "paths": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "glob"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "pattern"
            ]
          }
        }
      ]
    },
    "partial_selectors": {
      "type": "object",
      "properties": {
        "domain": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "time_indices": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "time_range": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "oneOf": [
                {
                  "$ref": "#/$defs/time_token"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "oneOf": [
                {
                  "$ref": "#/$defs/time_token"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "max_files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "partial_render": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "dpi": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "partial_output": {
      "type": "object",
      "properties": {
        "subdir": {
          "type": "string",
          "minLength": 1
        },
        "file_stem": {
          "type": [
            "string",
            "null"
          ]
        },
        "sidecar_json": {
          "type": "boolean"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "properties": {
        "inputs": {
          "$ref": "#/$defs/partial_inputs"
        },
        "selectors": {
          "$ref": "#/$defs/partial_selectors"
        },
        "render": {
          "$ref": "#/$defs/partial_render"
        },
        "output": {
          "$ref": "#/$defs/partial_output"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "level_selector": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "index",
                "first",
                "last"
              ]
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "layer_def": {
      "type": "object",
      "required": [
        "expr"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "expr": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "category": {
      "type": "object",
      "required": [
        "value",
        "color"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/category_value"
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "draw": {
      "type": "object",
      "required": [
        "kind",
        "style"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "raster",
            "contour",
            "categorical_fill"
          ]
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zorder": {
          "type": "number"
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "contour"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "style": {
                "type": "object",
                "properties": {
                  "levels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  },
                  "colors": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ]
                  },
                  "linewidths": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    ]
                  },
                  "linestyles": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ]
                  },
                  "label_contours": {
                    "type": "boolean"
                  },
                  "label_format": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "levels"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "categorical_fill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "style": {
                "type": "object",
                "properties": {
                  "categories": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/category"
                    }
                  }
                },
                "required": [
                  "categories"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "render_layer": {
      "type": "object",
      "required": [
        "layer_id"
      ],
      "properties": {
        "layer_id": {
          "type": "string",
          "minLength": 1
        },
        "style_id": {
          "type": "string",
          "minLength": 1
        },
        "draw": {
          "$ref": "#/$defs/draw"
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "draw"
          ]
        },
        {
          "required": [
            "style_id"
          ]
        }
      ]
    },
    "figure": {
      "type": "object",
      "required": [
        "figure_id",
        "layers"
      ],
      "properties": {
        "figure_id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "selectors": {
          "$ref": "#/$defs/partial_selectors"
        },
        "render": {
          "$ref": "#/$defs/partial_render"
        },
        "output": {
          "$ref": "#/$defs/partial_output"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/render_layer"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
