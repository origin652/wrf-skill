{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WRF post-processing specification",
  "type": "object",
  "required": [
    "schema_version",
    "layer_defs"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        3,
        4
      ]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "style_defs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/draw"
      }
    },
    "view_defs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/view_def"
      }
    },
    "layer_defs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/layer_def"
      }
    },
    "region_defs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/region_def"
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/figure"
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chart"
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "figures": {
          "minItems": 1
        }
      },
      "required": [
        "figures"
      ]
    },
    {
      "properties": {
        "charts": {
          "minItems": 1
        }
      },
      "required": [
        "charts"
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "time_token": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    },
    "category_value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "partial_inputs": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "project_artifacts",
            "explicit_paths",
            "glob"
          ]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "allOf": [
        {
          "$ref": "#/$defs/partial_inputs"
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "project_artifacts"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "artifact"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "explicit_paths"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "paths"
            ],
            "properties": {
              "paths": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "glob"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "pattern"
            ]
          }
        }
      ]
    },
    "partial_selectors": {
      "type": "object",
      "properties": {
        "domain": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "time_indices": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "time_range": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "start": {
              "oneOf": [
                {
                  "$ref": "#/$defs/time_token"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "oneOf": [
                {
                  "$ref": "#/$defs/time_token"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "max_files": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "partial_render": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "dpi": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "partial_output": {
      "type": "object",
      "properties": {
        "subdir": {
          "type": "string",
          "minLength": 1
        },
        "file_stem": {
          "type": [
            "string",
            "null"
          ]
        },
        "sidecar_json": {
          "type": "boolean"
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "properties": {
        "inputs": {
          "$ref": "#/$defs/partial_inputs"
        },
        "selectors": {
          "$ref": "#/$defs/partial_selectors"
        },
        "render": {
          "$ref": "#/$defs/partial_render"
        },
        "output": {
          "$ref": "#/$defs/partial_output"
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "level_selector": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "index",
                "first",
                "last"
              ]
            },
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "layer_def": {
      "type": "object",
      "required": [
        "expr"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "expr": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "view_axis": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "native_dim",
            "derived_coord",
            "path_coord"
          ]
        },
        "name": {
          "type": "string",
          "enum": [
            "time",
            "bottom_top",
            "south_north",
            "west_east",
            "height_m",
            "pressure_hpa",
            "distance_km"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "view_selector": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "current",
            "first",
            "last",
            "index",
            "nearest_index",
            "value",
            "nearest_value",
            "mean",
            "min",
            "max",
            "sum"
          ]
        },
        "index": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "view_def": {
      "type": "object",
      "required": [
        "x_axis",
        "y_axis"
      ],
      "properties": {
        "x_axis": {
          "$ref": "#/$defs/view_axis"
        },
        "y_axis": {
          "$ref": "#/$defs/view_axis"
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/view_selector"
          }
        },
        "sampling": {
          "type": "object",
          "properties": {
            "path": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "polyline"
                  ]
                },
                "points": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "lat",
                      "lon"
                    ],
                    "properties": {
                      "lat": {
                        "type": "number"
                      },
                      "lon": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "samples": {
                  "type": "integer",
                  "minimum": 2
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "category": {
      "type": "object",
      "required": [
        "value",
        "color"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/category_value"
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "draw": {
      "type": "object",
      "required": [
        "kind",
        "style"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "raster",
            "contour",
            "categorical_fill",
            "vector"
          ]
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "zorder": {
          "type": "number"
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "contour"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "style": {
                "type": "object",
                "properties": {
                  "levels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "number"
                    }
                  },
                  "colors": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ]
                  },
                  "linewidths": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    ]
                  },
                  "linestyles": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    ]
                  },
                  "label_contours": {
                    "type": "boolean"
                  },
                  "label_format": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "levels"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "categorical_fill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "style": {
                "type": "object",
                "properties": {
                  "categories": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/category"
                    }
                  }
                },
                "required": [
                  "categories"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "vector"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "style": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "quiver"
                    ]
                  },
                  "stride": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "scale": {
                    "type": "number"
                  },
                  "color": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pivot": {
                    "type": "string",
                    "enum": [
                      "tail",
                      "mid",
                      "middle",
                      "tip"
                    ]
                  },
                  "axis_projection": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "map_xy",
                          "path_section"
                        ]
                      },
                      "x_component": {
                        "type": "string",
                        "enum": [
                          "u",
                          "v",
                          "path_tangent",
                          "path_normal",
                          "vertical"
                        ]
                      },
                      "y_component": {
                        "type": "string",
                        "enum": [
                          "u",
                          "v",
                          "path_tangent",
                          "path_normal",
                          "vertical"
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      ]
    },
    "render_layer": {
      "type": "object",
      "properties": {
        "layer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "u_layer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "v_layer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "vertical_layer_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "style_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "draw": {
          "$ref": "#/$defs/draw"
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "draw"
          ]
        },
        {
          "required": [
            "style_id"
          ]
        }
      ],
      "oneOf": [
        {
          "required": [
            "layer_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "u_layer_id"
                ]
              },
              {
                "required": [
                  "v_layer_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "u_layer_id",
            "v_layer_id"
          ],
          "not": {
            "required": [
              "layer_id"
            ]
          }
        }
      ]
    },
    "figure": {
      "type": "object",
      "required": [
        "figure_id",
        "layers"
      ],
      "properties": {
        "figure_id": {
          "type": "string",
          "minLength": 1
        },
        "view_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "view": {
          "$ref": "#/$defs/view_def"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "selectors": {
          "$ref": "#/$defs/partial_selectors"
        },
        "render": {
          "$ref": "#/$defs/partial_render"
        },
        "output": {
          "$ref": "#/$defs/partial_output"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/render_layer"
          }
        }
      },
      "additionalProperties": true
    },
    "region_selector": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "index_range"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "stop": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "mode",
        "start",
        "stop"
      ],
      "additionalProperties": true
    },
    "region_def": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "bottom_top": {
          "$ref": "#/$defs/region_selector"
        },
        "south_north": {
          "$ref": "#/$defs/region_selector"
        },
        "west_east": {
          "$ref": "#/$defs/region_selector"
        }
      },
      "additionalProperties": true
    },
    "chart_reduce": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "mean",
            "min",
            "max",
            "sum"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": true
    },
    "chart_series": {
      "type": "object",
      "required": [
        "series_id",
        "label",
        "layer_id"
      ],
      "properties": {
        "series_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "layer_id": {
          "type": "string",
          "minLength": 1
        },
        "region_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reduce": {
          "$ref": "#/$defs/chart_reduce"
        }
      },
      "additionalProperties": true
    },
    "chart_x": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "time",
            "group"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "chart": {
      "type": "object",
      "required": [
        "chart_id",
        "chart_kind",
        "x",
        "series"
      ],
      "properties": {
        "chart_id": {
          "type": "string",
          "minLength": 1
        },
        "chart_kind": {
          "type": "string",
          "enum": [
            "line",
            "bar",
            "boxplot"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "selectors": {
          "$ref": "#/$defs/partial_selectors"
        },
        "render": {
          "$ref": "#/$defs/partial_render"
        },
        "output": {
          "$ref": "#/$defs/partial_output"
        },
        "x": {
          "$ref": "#/$defs/chart_x"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chart_series"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
